        "arn:aws:lambda:ap-northeast-1:138681986450:function:pokeca-app-image",
        "arn:aws:lambda:ap-northeast-1:138681986450:function:pokeca-app-server"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
