# S3 스토리지 (서브 D). 버킷명은 terraform output. 로컬 자격은 AWS_PROFILE=artpoke.
AWS_REGION=ap-northeast-1
S3_BUCKET_UPLOADS=pokeca-uploads-138681986450
S3_BUCKET_EVIDENCE=pokeca-consent-evidence-138681986450
# 정리 작업 호출 인증(Vercel Cron). 임의의 긴 문자열.
CRON_SECRET=
# 신고 남용 방지용 IP 대역 해시 비밀값. 임의의 긴 문자열.
REPORT_HASH_SECRET=
# 신고 알림 메일(Resend). 셋 중 하나라도 비면 메일 대신 서버 로그로만 남긴다.
RESEND_API_KEY=
# 받는 주소(쉼표로 여러 개)
REPORT_NOTIFY_TO=
# Resend에서 인증한 도메인의 주소. 예: 확장 아트 <alerts@example.com>
REPORT_NOTIFY_FROM=

# --- AWS 이전(서브 C): Drizzle 직결 + Auth.js ---
DATABASE_URL=postgresql://pokeca:pokeca@localhost:5432/pokeca
AUTH_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
